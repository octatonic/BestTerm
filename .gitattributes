# Normalise line endings so a Windows and a Linux checkout produce byte-identical
# source. Without this, `cargo fmt --check` and any snapshot test can disagree
# between the two CI runners for no reason other than the checkout.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touched.
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.crate binary

# Keep the licence verbatim; it is a legal document, not source.
LICENSE -text
